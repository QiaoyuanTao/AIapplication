PORT=7001

# Ollama /api/chat 地址（不要带 /api/generate 后缀）
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
LLM_TIMEOUT_MS=30000

# 和风天气：在控制台「设置 - API Host」查看 KEY 绑定的域名后填入
HEFENG_API_KEY=
QWEATHER_API_HOST=devapi.qweather.com
QWEATHER_GEO_HOST=geoapi.qweather.com

# 百度翻译：传统 appid + 密钥用 sign；真正的 API Key 才用 api-key
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_AUTH_MODE=sign
